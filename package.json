{
    "name": "solanabot",
    "version": "6.0.0",
    "description": "Solana bot",
    "main": "./src/bot.ts",
    "scripts": {
        "build": "bun build ./src/bot.ts --outdir ./dist --target bun",
        "start": "bun run ./src/bot.ts",
        "typecheck": "bunx tsc --noEmit",
        "prune": "ts-prune",
        "format": "prettier --config .prettierrc 'src/**/*.ts' --write"
    },
    "author": "deezzir@gmail.com",
    "license": "ISC",
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/figlet": "^1.7.0",
        "@types/inquirer": "^9.0.10",
        "@types/node": "^26.2.0",
        "prettier": "^3.9.6",
        "ts-prune": "^0.10.3",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@solana/spl-token": "^0.4.15",
        "@solana/web3.js": "^1.98.4",
        "bs58": "^6.0.0",
        "commander": "^15.0.0",
        "csv-parse": "^7.0.2",
        "dotenv": "^17.4.2",
        "figlet": "^1.11.4",
        "helius-sdk": "^1.5.3",
        "inquirer": "^14.0.2"
    }
}
