{
    "name": "solana-bot",
    "version": "1.1.4",
    "description": "Solana bot",
    "author": "deezzir@gmail.com",
    "license": "MIT",
    "main": "./src/bot.ts",
    "bin": {
        "solana-bot": "./src/bot.ts"
    },
    "files": [
        "src",
        "!src/scripts",
        "!src/**/*.test.ts",
        "!src/**/*.spec.ts"
    ],
    "packageManager": "bun@1.4.2",
    "engines": {
        "bun": ">=1.3.14"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Deezzir/solana-bot.git"
    },
    "scripts": {
        "start": "bun run ./src/bot.ts",
        "test": "bun test",
        "test:coverage": "bun test --coverage",
        "typecheck": "bunx tsc --noEmit",
        "typecheck:test": "bunx tsc --noEmit -p tsconfig.test.json",
        "lint": "prettier --config .prettierrc 'src/**/*.ts' --check",
        "lint:test": "prettier --config .prettierrc 'tests/**/*.ts' 'tsconfig.test.json' 'package.json' --check",
        "prune": "ts-prune",
        "format": "prettier --config .prettierrc 'src/**/*.ts' --write"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "@types/figlet": "^1.7.0",
        "@types/inquirer": "^9.0.10",
        "@types/node": "^26.2.0",
        "prettier": "^3.9.6",
        "ts-prune": "^0.10.3",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "@solana-program/token": "^0.16.1",
        "@solana-program/token-2022": "^0.19.0",
        "@solana/web3.js": "3.0.0-rc.3",
        "bs58": "^6.0.0",
        "commander": "^15.0.0",
        "csv-parse": "^7.0.2",
        "figlet": "^1.11.4",
        "inquirer": "^14.0.2"
    }
}
